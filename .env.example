# Strava OAuth credentials (from your Strava API app)
CLIENT_ID=your_strava_client_id
CLIENT_SECRET=your_strava_client_secret
REFRESH_TOKEN=your_40_char_refresh_token

# Shared secret — pick anything hard to guess
SKILL_SECRET=your-shared-secret

# Set after first deploy (copied from CDK output)
BASE_URL=https://xxxx.execute-api.region.amazonaws.com

# Your training goal — appears in the coaching persona
TRAINING_GOAL=training for a marathon

# intervals.icu API key (Settings → Developer Settings on intervals.icu)
INTERVALS_API_KEY=your_intervals_icu_api_key

# Set after first `make deploy-intervals` (copied from CDK output)
INTERVALS_BASE_URL=https://xxxx.execute-api.region.amazonaws.com

# Local debugging only — see "Local debugging" in the README. Ignored in Lambda.
# ARN of the deployed secret; find it with:
#   aws secretsmanager describe-secret --secret-id IntervalsSkillStack/intervals/api --query ARN --output text
SECRET_ARN=arn:aws:secretsmanager:region:account:secret:IntervalsSkillStack/intervals/api-xxxxxx
AWS_REGION=ca-west-1
